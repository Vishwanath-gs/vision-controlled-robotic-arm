<?xml version="1.0"?>
<robot name="pkg_04_assembly">

    <!-- World anchor -->
    <link name="world"/>

    <!-- Robot root -->
    <link name="root"/>

    <!-- ==================== PART 1 ==================== -->
    <link name="part_1">
        <inertial>
            <mass value="0.199394"/>
            <origin xyz="-8.47886e-19 -2.09486e-34 0.0168487" rpy="0 0 0"/>
            <inertia
                ixx="2.113904e-4"
                ixy="0"
                ixz="0"
                iyy="2.113904e-4"
                iyz="0"
                izz="3.819474e-4"/>
        </inertial>

        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh
                    filename="package://pkg_04_assembly/meshes/Part_1.stl"
                    scale="1 1 1"/>
            </geometry>
            <material name="part_1_material">
                <color rgba="0.615686 0.811765 0.929412 1"/>
            </material>
        </visual>

        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.12 0.12 0.04"/>
            </geometry>
        </collision>
    </link>


    <!-- ==================== PART 2 ==================== -->
    <link name="part_2">
        <inertial>
            <mass value="1.788788"/>
            <origin xyz="-6.18219e-13 -0.00903038 0.0514239" rpy="0 0 0"/>
            <inertia
                ixx="3.198229e-3"
                ixy="0"
                ixz="0"
                iyy="3.321539e-3"
                iyz="4.503663e-4"
                izz="2.056987e-3"/>
        </inertial>

        <visual>
            <origin xyz="0 0 -0.03" rpy="0 0 0"/>
            <geometry>
                <mesh
                    filename="package://pkg_04_assembly/meshes/Part_2.stl"
                    scale="1 1 1"/>
            </geometry>
            <material name="part_2_material">
                <color rgba="0.647059 0.647059 0.647059 1"/>
            </material>
        </visual>

        <collision>
            <origin xyz="0 0 -0.03" rpy="0 0 0"/>
            <geometry>
                <box size="0.08 0.08 0.10"/>
            </geometry>
        </collision>
    </link>


    <!-- ==================== PART 3 ==================== -->
    <link name="part_3">
        <inertial>
            <mass value="1.197003"/>
            <origin xyz="-4.98319e-19 0.0175 0.07" rpy="0 0 0"/>
            <inertia
                ixx="3.826329e-3"
                ixy="0"
                ixz="0"
                iyy="4.190018e-3"
                iyz="0"
                izz="6.081043e-4"/>
        </inertial>

        <visual>
            <origin xyz="5.20417e-18 0 -0.13" rpy="0 0 0"/>
            <geometry>
                <mesh
                    filename="package://pkg_04_assembly/meshes/Part_3.stl"
                    scale="1 1 1"/>
            </geometry>
            <material name="part_3_material">
                <color rgba="0.231373 0.380392 0.705882 1"/>
            </material>
        </visual>

        <collision>
            <origin xyz="0 0 -0.13" rpy="0 0 0"/>
            <geometry>
                <box size="0.07 0.07 0.14"/>
            </geometry>
        </collision>
    </link>


    <!-- ==================== PART 4 ==================== -->
    <link name="part_4">
        <inertial>
            <mass value="0.053478"/>
            <origin xyz="4.91126e-17 -5.55871e-20 0.0563321" rpy="0 0 0"/>
            <inertia
                ixx="3.748656e-5"
                ixy="0"
                ixz="0"
                iyy="5.343628e-5"
                iyz="0"
                izz="1.681456e-5"/>
        </inertial>

        <visual>
            <origin xyz="0 -3.06162e-19 -0.355" rpy="0 0 0"/>
            <geometry>
                <mesh
                    filename="package://pkg_04_assembly/meshes/Part_4.stl"
                    scale="1 1 1"/>
            </geometry>
            <material name="part_4_material">
                <color rgba="0.768627 0.886275 0.952941 1"/>
            </material>
        </visual>

        <collision>
            <origin xyz="0 0 -0.355" rpy="0 0 0"/>
            <geometry>
                <box size="0.08 0.08 0.07"/>
            </geometry>
        </collision>
    </link>


    <!-- ==================== PART 5 ==================== -->
    <link name="part_5">
        <inertial>
            <mass value="0.482895"/>
            <origin xyz="0.000328304 -0.00586971 0.0359631" rpy="0 0.00912865 0"/>
            <inertia
                ixx="7.319371e-4"
                ixy="3.181165e-7"
                ixz="-4.913807e-6"
                iyy="7.741030e-4"
                iyz="3.484726e-5"
                izz="1.937143e-4"/>
        </inertial>

        <visual>
            <origin xyz="-0.0024647 0 -0.269989" rpy="0 0.00912865 0"/>
            <geometry>
                <mesh
                    filename="package://pkg_04_assembly/meshes/Part_5.stl"
                    scale="1 1 1"/>
            </geometry>
            <material name="part_5_material">
                <color rgba="0.972549 0.529412 0.00392157 1"/>
            </material>
        </visual>

        <collision>
            <origin xyz="-0.0024647 0 -0.269989" rpy="0 0.00912865 0"/>
            <geometry>
                <box size="0.06 0.06 0.085"/>
            </geometry>
        </collision>
    </link>


    <!-- ==================== WORLD → ROOT ==================== -->
    <joint name="world_to_root" type="fixed">
        <parent link="world"/>
        <child link="root"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>


    <!-- ==================== ROOT → PART 1 ==================== -->
    <joint name="fixed_node_to_root_joint" type="fixed">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <parent link="root"/>
        <child link="part_1"/>
    </joint>


    <!-- ==================== PART 1 → PART 2 ==================== -->
    <joint name="revolute_1" type="revolute">
        <origin
            xyz="0 -2.77556e-17 0.03"
            rpy="5.83202e-22 2.77556e-17 1.44329e-15"/>
        <axis xyz="0 0 -1"/>
        <parent link="part_1"/>
        <child link="part_2"/>
        <limit
            effort="8"
            velocity="1.5"
            lower="-3.14159"
            upper="3.14159"/>
    </joint>


    <!-- ==================== PART 2 → PART 3 ==================== -->
    <joint name="revolute_2" type="revolute">
        <origin
            xyz="8.32667e-17 2.77556e-17 0.1"
            rpy="-1.72114e-17 0.0191658 1.44221e-15"/>
        <axis xyz="0 -1 0"/>
        <parent link="part_2"/>
        <child link="part_3"/>
        <limit
            effort="20"
            velocity="1"
            lower="-1.83088"
            upper="1.86921"/>
    </joint>


    <!-- ==================== PART 3 → PART 5 ==================== -->
    <joint name="revolute_3" type="revolute">
        <origin
            xyz="-1.66533e-16 2.77556e-17 0.14"
            rpy="-1.1864e-15 2.7426e-15 -3.61407e-16"/>
        <axis xyz="0 1 0"/>
        <parent link="part_3"/>
        <child link="part_5"/>
        <limit
            effort="12"
            velocity="1"
            lower="-2.38278"
            upper="2.36452"/>
    </joint>


    <!-- ==================== PART 5 → PART 4 ==================== -->
    <joint name="revolute_4" type="revolute">
        <origin
            xyz="0.000775924 1.66533e-16 0.0849965"
            rpy="0.0010424 0.00906894 0.114441"/>
        <axis xyz="0 0 -1"/>
        <parent link="part_5"/>
        <child link="part_4"/>
        <limit
            effort="3"
            velocity="2"
            lower="-3.14159"
            upper="3.14159"/>

    </joint>
<ros2_control name="GazeboSystem" type="system">

    <hardware>
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <joint name="revolute_1">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
    </joint>

    <joint name="revolute_2">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
    </joint>

    <joint name="revolute_3">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
    </joint>

    <joint name="revolute_4">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
    </joint>

</ros2_control>

<gazebo>
    <plugin
        filename="gz-sim-joint-position-controller-system"
        name="gz::sim::systems::JointPositionController">

        <joint_name>revolute_1</joint_name>

        <topic>/arm/j1/cmd</topic>

        <p_gain>5</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0.5</d_gain>
    </plugin>
</gazebo>
<gazebo>
    <plugin
        filename="gz-sim-joint-position-controller-system"
        name="gz::sim::systems::JointPositionController">

        <joint_name>revolute_2</joint_name>
        <topic>/arm/j2/cmd</topic>

        <p_gain>15</p_gain>
        <i_gain>0</i_gain>
        <d_gain>1.5</d_gain>
    </plugin>
</gazebo>
<gazebo>
    <plugin
        filename="gz-sim-joint-position-controller-system"
        name="gz::sim::systems::JointPositionController">

        <joint_name>revolute_3</joint_name>
        <topic>/arm/j3/cmd</topic>

        <p_gain>10</p_gain>
        <i_gain>0</i_gain>
        <d_gain>1.0</d_gain>
    </plugin>
</gazebo>

<gazebo>
    <plugin
        filename="gz-sim-joint-position-controller-system"
        name="gz::sim::systems::JointPositionController">

        <joint_name>revolute_4</joint_name>
        <topic>/arm/j4/cmd</topic>

        <p_gain>5</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0.5</d_gain>
    </plugin>
</gazebo>

</robot>