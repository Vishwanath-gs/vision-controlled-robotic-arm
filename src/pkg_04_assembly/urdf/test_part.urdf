<?xml version="1.0"?>

<robot name="test_part">

  <link name="base">
  </link>

  <joint name="base_joint" type="fixed">
    <parent link="base"/>
    <child link="part_1"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="part_1">

    <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>

        <geometry>
            <mesh filename="package://pkg_04_assembly/meshes/Part_1.stl"
                  scale="1 1 1"/>
        </geometry>
    

        <material name="blue">
           <color rgba="0.2 0.4 0.8 1.0"/>
        </material>
    </visual>

  </link>

</robot>